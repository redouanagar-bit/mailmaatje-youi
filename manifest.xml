<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>3c1f2a77-6b8e-4e35-9a0f-2d7a1b5e9c41</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>YOUI Advies</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="Mailmaatje"/>
  <Description DefaultValue="Interne notitie, deadline, verantwoordelijke en status per e-mail."/>
  <IconUrl DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-128.png"/>
  <SupportUrl DefaultValue="https://youiadvies.nl"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mn.group">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mn.open">
                    <Label resid="BtnLabel"/>
                    <Supertip><Title resid="BtnLabel"/><Description resid="BtnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Mailmaatje"/>
          <bt:String id="BtnLabel" DefaultValue="Notitie"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="BtnDesc" DefaultValue="Interne notitie, deadline, verantwoordelijke en status bij deze e-mail."/>
        </bt:LongStrings>
      </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mn.group">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mn.open">
                    <Label resid="BtnLabel"/>
                    <Supertip><Title resid="BtnLabel"/><Description resid="BtnDesc"/></Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://redouanagar-bit.github.io/mailmaatje-youi/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Mailmaatje"/>
          <bt:String id="BtnLabel" DefaultValue="Notitie"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="BtnDesc" DefaultValue="Interne notitie, deadline, verantwoordelijke en status bij deze e-mail."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
